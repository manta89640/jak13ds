; ctr_mesh_morph.v.pica with the fog in the color's alpha (ctr_mesh_opt_fa.v.pica's outputs): the
; draws whose vertices all have alpha 0x80, and the alpha mask textures (c3l v23) on unit 1.
; Every output component is written exactly once (platform/3ds/tools/check_shaders.py).

.fvec clip[6]       ; as ctr_mesh_opt.v.pica
.fvec scales
.fvec fog1
.fvec morph[80]     ; per row: x, y = the morph factors of band 1, 2

.out outpos position
.out outtc0 texcoord0.xy
.out - texcoord1 outtc0.zw
.out outclr color

.alias inpos v0
.alias intex v1
.alias inclr v2
.alias indelta v3   ; xyz: band 1 offset, w: row
.alias indelta2 v4  ; xyz: band 2 offset

.entry main_ctr_mesh_morph_fa
.proc main_ctr_mesh_morph_fa
  mova a0.x, indelta.w
  mul outtc0, scales.xxxx, intex.xyxy
  mul r1.xyz, morph[a0.x].xxxx, indelta
  mul r2.xyz, morph[a0.x].yyyy, indelta2
  add r1.xyz, r1, r2
  add r1.xyz, inpos, r1
  dph r0.x, r1, clip[5]
  dph r0.y, r1, clip[4]
  dph outpos.x, r1, clip[0]
  dph outpos.y, r1, clip[1]
  max r0.xy, fog1.xyxy, r0.xyxy
  dph outpos.z, r1, clip[2]
  mul outclr.xyz, scales.yyyy, inclr
  max outclr.w, -r0.xxxx, r0.yyyy
  dph outpos.w, r1, clip[3]
  end
.end
