; (AI-assisted)
; Vertex shader for static meshes (level backgrounds, c3l::Vertex): quantized positions go through
; one matrix straight to clip space (camera, chunk origin/scale, screen rotation all folded in).
; Also computes the fog amount (texcoord1.x, looked up in a fog color / alpha ramp texture):
; the game's fog like tfrag3.vert (255 - clamp(hvdf.w - w, fog_min, fog_max)) / 255, and an extra
; fog towards the draw distance, whichever is larger.

.fvec clip[4]
.fvec scales        ; x: texture coordinate scale (1/1024), y: color scale (1/255), z: 1.0
.fvec fog0          ; x: hvdf.w, y: fog min, z: fog max, w: -1/255 (no game fog: 0, 255, 255)
.fvec fog1          ; x: clip w -> game units, y: extra fog start, z: 1 / (end - start)

.constf consts(1.0, 0.5, 0.0, 0.0)

.out outpos position
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outclr color

.alias inpos v0
.alias intex v1
.alias inclr v2

.proc main
  mov r0.xyz, inpos
  mov r0.w, scales.zzzz

  dp4 outpos.x, clip[0], r0
  dp4 outpos.y, clip[1], r0
  dp4 outpos.z, clip[2], r0
  dp4 r1.x, clip[3], r0
  mov outpos.w, r1.xxxx

  ; game fog
  add r2.x, fog0.xxxx, -r1.xxxx
  max r2.x, fog0.yyyy, r2.xxxx
  min r2.x, fog0.zzzz, r2.xxxx
  mul r2.x, fog0.wwww, r2.xxxx
  add r2.x, consts.xxxx, r2.xxxx
  ; draw distance fog
  mul r3.x, fog1.xxxx, r1.xxxx
  add r3.x, -fog1.yyyy, r3.xxxx
  mul r3.x, fog1.zzzz, r3.xxxx
  max r2.x, r2.xxxx, r3.xxxx
  mov r2.y, consts.yyyy
  mov r2.zw, consts.zzzz
  mov outtc1, r2

  mul outtc0, scales.xxxx, intex
  mul outclr, scales.yyyy, inclr
  end
.end
