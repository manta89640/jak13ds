; (AI-assisted)
; Vertex shader for static meshes (level backgrounds, c3l::Vertex): quantized positions go through
; one matrix straight to clip space (camera, chunk origin/scale, screen rotation all folded in).
; Also computes the fog amount (texcoord1.x, looked up in a fog color / alpha ramp texture):
; the game's fog like tfrag3.vert (255 - clamp(hvdf.w - w, fog_min, fog_max)) / 255, and an extra
; fog towards the draw distance, whichever is larger.
; (AI-assisted) Both fogs are affine in clip w: fog0 holds their factors and offsets, fog1 the
; game fog's clamps, made from the game's values by mesh_fog_uniforms (ctr_gpu_citro3d.c).

.fvec clip[4]
.fvec scales        ; x: texture coordinate scale (1/1024), y: color scale (1/255), z: 1.0
.fvec fog0          ; -(game fog) = fog0.x * w + fog0.z, draw distance fog = fog0.y * w + fog0.w
.fvec fog1          ; x: -(the game fog's upper clamp), y: the game fog's lower clamp

.constf consts(1.0, 0.5, 0.0, 0.0)

.out outpos position
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outclr color

.alias inpos v0
.alias intex v1
.alias inclr v2

.proc main
  ; dph: the position's pad (w) counts as 1
  dph outpos.x, inpos, clip[0]
  dph outpos.y, inpos, clip[1]
  dph outpos.z, inpos, clip[2]
  dph r1, inpos, clip[3]
  mov outpos.w, r1

  ; r2.x = -min(game fog, its upper clamp), r2.y = max(draw distance fog, game fog's lower clamp);
  ; the fog is the larger of -r2.x and r2.y (the same as clamping the game fog, then the max)
  mul r2.xy, fog0.xyxy, r1.xyxy
  add r2.xy, fog0.zwzw, r2.xyxy
  max r2.xy, fog1.xyxy, r2.xyxy
  max outtc1.x, -r2.xxxx, r2.yyyy
  mov outtc1.y, consts.yyyy

  mul outtc0, scales.xxxx, intex
  mul outclr, scales.yyyy, inclr
  end
.end
