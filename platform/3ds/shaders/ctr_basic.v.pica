; (AI-assisted)
; Vertex shader for the 3DS renderer (game/graphics/ctr): positions are already in the renderer's
; normalized space, the projection handles the 4:3 letterbox and the screen rotation.

.fvec projection[4]

.constf consts(1.0, 0.00392156862745098, 0.0, 0.0)
.alias ones consts.xxxx
.alias inv255 consts.yyyy

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intex v1
.alias inclr v2

.proc main
  mov r0.xyz, inpos
  mov r0.w, ones

  dp4 outpos.x, projection[0], r0
  dp4 outpos.y, projection[1], r0
  dp4 outpos.z, projection[2], r0
  dp4 outpos.w, projection[3], r0

  mov outtc0, intex
  mul outclr, inv255, inclr
  end
.end
