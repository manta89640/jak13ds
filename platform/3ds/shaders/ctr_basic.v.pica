; (AI-assisted)
; Vertex shader for the 3DS renderer (game/graphics/ctr): positions are already in the renderer's
; normalized space, the projection handles the 4:3 letterbox and the screen rotation.

.fvec projection[4]

.constf consts(1.0, 0.00392156862745098, 0.0, 0.0)
.alias inv255 consts.yyyy

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intex v1
.alias inclr v2

.proc main
  ; (AI-assisted) dph: the position with w = 1, no mov needed
  dph outpos.x, inpos, projection[0]
  dph outpos.y, inpos, projection[1]
  dph outpos.z, inpos, projection[2]
  dph outpos.w, inpos, projection[3]

  mov outtc0, intex
  mul outclr, inv255, inclr
  end
.end
