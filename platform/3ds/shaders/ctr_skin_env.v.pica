; (AI-assisted)
; The envmap pass of skinned meshes (merc envmap effects: power cells, precursor metal). The same
; skinning as ctr_skin.v.pica; the texture coordinates are emerc.vert's sphere map from the camera
; space normal and position, the color is the effect's fade (texture stage: texture * color * 4).

.fvec clip[4]
.fvec row0[24]
.fvec row1[24]
.fvec row2[24]
.fvec scales        ; x: texture coordinate scale (1/1024), y: 1/255, z: 1.0, w: normal scale (1/127)
.fvec fade          ; the color: fade (1.0 = GS 0x80) / 2

.constf consts(0.0, 0.5, 0.0, 0.0)
.constf negz(0.0, 0.0, -1.0, 0.0)
.alias half consts.yyyy

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias inidx v1
.alias inwgt v2
.alias intex v3
.alias inclr v4
.alias innrm v5

.proc main
  ; blended bone rows r1-r3 (see ctr_skin.v.pica)
  mul r0, scales.yyyy, inwgt
  mova a0.xy, inidx.xy
  mul r1, row0[a0.x], r0.xxxx
  mul r2, row1[a0.x], r0.xxxx
  mul r3, row2[a0.x], r0.xxxx
  mad r1, r0.yyyy, row0[a0.y], r1
  mad r2, r0.yyyy, row1[a0.y], r2
  mad r3, r0.yyyy, row2[a0.y], r3
  mova a0.x, inidx.zzzz
  mad r1, r0.zzzz, row0[a0.x], r1
  mad r2, r0.zzzz, row1[a0.x], r2
  mad r3, r0.zzzz, row2[a0.x], r3

  ; camera space position (r4), then clip space
  dph r4.x, inpos, r1
  dph r4.y, inpos, r2
  dph r4.z, inpos, r3
  dph outpos.x, r4, clip[0]
  dph outpos.y, r4, clip[1]
  dph outpos.z, r4, clip[2]
  dph outpos.w, r4, clip[3]

  ; emerc.vert: v = camera space position (r4, -X * p like vtx_pos there), n = the rotated normal
  ; (-r5, normalized), m = (n.x, n.y, n.z - 1);
  ; w = v + m * dot(v, m) / m.z, st = 0.5 - 0.5 * w.xy / |w|.
  ; (AI-assisted) Scaled by m.z (<= 0, flips the sign): w' = m.z * v + m * dot(v, m),
  ; st = 0.5 + 0.5 * w'.xy / |w'|, no reciprocal.
  dp3 r5.x, innrm, r1
  dp3 r5.y, innrm, r2
  dp3 r5.z, innrm, r3
  dp3 r6.x, r5, r5
  rsq r6.x, r6.x
  mad r7, -r5, r6.xxxx, negz
  dp3 r8.x, r4, r7
  mul r9, r7.zzzz, r4
  mad r9, r7, r8.xxxx, r9
  dp3 r10.x, r9, r9
  rsq r10.x, r10.x
  mul r10.x, half, r10.x
  mad outtc0.xy, r9.xyyy, r10.xxxx, half
  mov outclr, fade
  end
.end
