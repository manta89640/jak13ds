; The PS2's tie geomorph (c3l::ExtMorph, ctr_gpu_draw_mesh_morph): ctr_mesh_opt.v.pica with each
; vertex moved first by its row's morph factors: pos + morph[row].x * delta + morph[row].y * delta2,
; in the chunk's quantized units (another attribute buffer: c3l::MorphVertex; row 0 is zero), its color
; toward its target (c3l::MorphChunk::colors, a third buffer) by its band's factor. The
; uniforms before morph are ctr_mesh_opt's, at the same places.
; Every output component is written exactly once (platform/3ds/tools/check_shaders.py).

; the fog: one dph with clip[4], the fog table row (fog_lut_update: the amount per clip w on unit 1)
.fvec clip[6]       ; as ctr_mesh_opt.v.pica
.fvec scales
.fvec fog1
.fvec morph[80]     ; per row: x, y = the morph factors of band 1, 2 (x the deltas' scale); z, w:
                    ; the color's factor g / 255, (1 - g) / 255 (row 0: 0, 1 / 255)

.out outpos position
.out outtc texcoord0.xy
.out - texcoord1 outtc.zw
.out outclr color

.alias inpos v0
.alias intex v1
.alias inclr v2
.alias indelta v3   ; xyz: band 1 offset, w: row
.alias indelta2 v4  ; xyz: band 2 offset
.alias intarget v5  ; rgb: the color target

.entry main_ctr_mesh_morph
.proc main_ctr_mesh_morph
  mova a0.x, indelta.w
  mul outtc.xy, scales.xxxx, intex.xyyy
  mul r1.xyz, morph[a0.x].xxxx, indelta
  mul r2.xyz, morph[a0.x].yyyy, indelta2
  add r1.xyz, r1, r2
  add r1.xyz, inpos, r1
  ; from here ctr_mesh_opt on the moved position r1 (dph reads its xyz)
  dph outtc.zw, r1, clip[4]
  dph outpos.x, r1, clip[0]
  dph outpos.y, r1, clip[1]
  dph outpos.z, r1, clip[2]
  dph outpos.w, r1, clip[3]
  ; the color: c + g * (target - c), g its row's band's factor (c3l::MorphChunk::colors)
  mul r8.xyz, morph[a0.x].wwww, inclr.xyzz
  mad outclr.xyz, intarget.xyzz, morph[a0.x].zzzz, r8.xyzz
  mul outclr.w, scales.yyyy, inclr.wwww
  end
.end
