; (AI-assisted) GS interpolation: screen-affine color/fog/reflection, projective STQ.
.fvec gs[4]

.constf consts(0.00392156862745098, 0.0, 0.0, 0.0)
.alias inv255 consts.xxxx

.out outpos position
.out outtc texcoord0.xy
.out - texcoord1 outtc.zw
.out outclr color
.out outtcq texcoord0w

.alias inpos v0  ; x, y, z, q (dph: w = 1)
.alias intex v1  ; s, t (times q), fog amount
.alias inclr v2

.entry main_ctr_ocean_full_opt
.proc main_ctr_ocean_full_opt
  dph r0.x, inpos, gs[0]
  dph r0.y, inpos, gs[1]
  dph r0.z, inpos, gs[2]
  dph r0.w, inpos, gs[3]
  mov outtc.xy, intex.xyyy
  mov outtc.zw, intex.zzzz
  mov outpos, r0
  mov outtcq, inpos.wwww
  mul outclr, inv255, inclr
  end
.end
