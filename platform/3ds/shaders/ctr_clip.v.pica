; (AI-assisted)
; Vertex shader for immediate draws given in OpenGL-style clip space (ctr_gpu_draw_clip: the sky),
; so that the GPU clips them (huge polygons, points behind the camera) and interpolates texture
; coordinates with perspective. glpica: OpenGL-style clip space -> PICA (see setup_projection).

.fvec glpica[4]

.constf consts(0.00392156862745098, 0.0, 0.0, 0.0)
.alias inv255 consts.xxxx

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intex v1
.alias inclr v2

.proc main
  dp4 outpos.x, glpica[0], inpos
  dp4 outpos.y, glpica[1], inpos
  dp4 outpos.z, glpica[2], inpos
  dp4 outpos.w, glpica[3], inpos

  mov outtc0, intex
  mul outclr, inv255, inclr
  end
.end
