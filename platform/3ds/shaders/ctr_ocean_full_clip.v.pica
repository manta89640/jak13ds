; (AI-assisted) GS interpolation: screen-affine color/fog/reflection, projective STQ.
.fvec gs[4]

.constf consts(0.00392156862745098, 0.5, 0.0, 0.0)
.alias inv255 consts.xxxx
.alias half consts.yyyy

.out outpos position
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outclr color
.out outtcq texcoord0w
.out outtc2 texcoord2

.alias inpos v0  ; W * (x, y, z, 1)
.alias intex v1  ; s, t, fog amount
.alias inclr v2
.alias inenv v3  ; (AI-assisted, j1ocean) es, et: the sky reflection's texture coordinates

; (AI-assisted) a named entry point: config.ini shader_groups links this file into a shbin with
; others (shared procedures need distinct names)
.entry main_ctr_ocean_full_clip
.proc main_ctr_ocean_full_clip
  dp4 r0.x, gs[0], inpos
  dp4 r0.y, gs[1], inpos
  dp4 r0.z, gs[2], inpos
  dp4 r0.w, gs[3], inpos
  rcp r1.x, inpos.w
  mul outpos, r0, r1.xxxx
  mov outtcq, r1.xxxx
  ; (AI-assisted) outputs built whole in temporaries and written once (zw = 0): partial output
  ; writes are the suspect in the new ctr_mesh.v.pica's hardware GPU hang (2026-10-03)
  mov r2.zw, consts.zzzz
  mul r2.xy, intex.xyyy, r1.xxxx
  mov outtc0, r2
  mov r3.zw, consts.zzzz
  mov r3.x, intex.zzzz
  mov r3.y, half
  mov outtc1, r3
  mul outclr, inv255, inclr
  ; (AI-assisted, j1ocean) texcoord2 (texture unit 2: the sky reflection's env map), zw = 0
  mov r4.zw, consts.zzzz
  mov r4.xy, inenv.xyyy
  mov outtc2, r4
  end
.end
