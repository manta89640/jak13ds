; (AI-assisted)
; config.ini pica_bench (game/graphics/ctr/ctr_gpu_bench.c): 7 instructions in a DVLB of its own (program switches between DVLBs)
; One DVLB with several entry points (ctr_bench_sep.shbin: this one only); every configured output component is written exactly
; once, whole registers only (platform/3ds/tools/check_shaders.py). Input: v0 position (w = 1),
; v1 texture coordinates, v2 color (0..255).

.fvec bproj[4]
.fvec bscales      ; x: texcoord scale, y: color scale (1/255)
.constf bk_ctr_bench_sep(1.0, 0.0, 0.0, 0.0)

.out opos position
.out otc0 texcoord0
.out oclr color

.entry ctr_bench_sep
.proc ctr_bench_sep
  dp4 opos.x, bproj[0], v0
  dp4 opos.y, bproj[1], v0
  dp4 opos.z, bproj[2], v0
  dp4 opos.w, bproj[3], v0
  mul otc0, bscales.xxxx, v1
  mul oclr, bscales.yyyy, v2
  end
.end
