# (AI-assisted) Jak II water spots (j2water): title ocean, the port, city canals (slums b,
# industrial), the sewer, the forest. Shots for side by side images against the PC renderer.
400 shot title_ocean
1000 continue ctyport-start
1001 -
1002 wait *target* target-stance
1003 log stop: port
1300 shot port_a
1301 rx=0
1350 -
1351 shot port_b
1352 rx=0
1400 -
1401 shot port_c
1500 continue ctyslumb-start
1501 -
1502 wait *target* target-stance
1503 log stop: slumb
1800 shot slumb_a
1801 rx=0
1850 -
1851 shot slumb_b
1852 rx=0
1900 -
1901 shot slumb_c
2000 continue ctyinda-start
2001 -
2002 wait *target* target-stance
2003 log stop: inda
2300 shot inda_a
2301 rx=0
2350 -
2351 shot inda_b
2352 rx=0
2400 -
2401 shot inda_c
2500 continue sewer-start
2501 -
2502 wait *target* target-stance
2503 log stop: sewer
2800 shot sewer_a
2801 rx=0
2850 -
2851 shot sewer_b
2852 rx=0
2900 -
2901 shot sewer_c
3000 continue forest-start
3001 -
3002 wait *target* target-stance
3003 log stop: forest
3300 shot forest_a
3301 rx=0
3350 -
3351 shot forest_b
3352 rx=0
3400 -
3401 shot forest_c
3500 exit
