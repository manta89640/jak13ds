  (local-vars (v1-1 uint128) (v1-2 uint128))
  (rlet ((vf1 :class vf))
    (let ((v1-0 (the-as uint128 (-> (the-as (pointer int32) arg1) 0))))
      (.pextlb v1-1 0 v1-0)
      )
    (.pextlh v1-2 0 v1-1)
    (.mov vf1 v1-2)
    (.itof.vf vf1 vf1)
    (.svf (&-> arg0 quad) vf1)
    0
    (none)
    )
  )

;; ERROR: Unsupported inline assembly instruction kind - [psrah a2, a2, 8]

;; og:preserve-this (AI-assisted) 3DS: the packet CtrOceanRenderer reads (game/graphics/ctr/CtrOcean.cpp
;; Packet; goal_src/jak1/engine/gfx/ocean/ocean.gc draw-ocean-3ds): the map's addresses, this frame's
;; 32 x 32 wave heights, the height and the camera, in the ocean-near bucket.
(#when TARGET_3DS
;; (AI-assisted, j2water) a texture's tex0 (as adgif-shader<-texture-simple! makes it), 0 for none
(defun ocean-3ds-tex0 ((tex texture))
  (if tex
      (let ((sh (new 'stack 'adgif-shader)))
        (adgif-shader<-texture-simple! sh tex)
        (the-as uint (-> sh tex0)))
      (the-as uint 0)))

;; (AI-assisted, j2water) every second frame: the env map the PS2 renders for the ocean's sky
;; reflection (ocean-method-89: the sky color, the sun and moon glows, the haze and the lit
;; clouds, drawn from above, then warped around), its GS packets in the ocean-mid-far bucket as on
;; the PS2. The 3DS renderer draws them into a render target (CtrOceanEnvJak2, CtrOcean.cpp) and
;; does the warp itself; the frames between keep the last one.
(define *ocean-3ds-env-count* 0)
(defun ocean-3ds-envmap ((this ocean))
  (set! *ocean-3ds-env-count* (+ *ocean-3ds-env-count* 1))
  (when (zero? (logand *ocean-3ds-env-count* 1))
    (mem-copy! (the-as pointer (-> this cloud-lights)) (the-as pointer (-> *sky-work* cloud-lights)) 156)
    (let* ((buf (-> *display* frames (-> *display* on-screen) global-buf))
           (start (-> buf base)))
      (ocean-method-89 this buf)
      (let ((end (-> buf base)))
        (let ((next (the-as dma-packet (-> buf base))))
          (set! (-> next dma) (new 'static 'dma-tag :id (dma-tag-id next)))
          (set! (-> next vif0) (new 'static 'vif-tag))
          (set! (-> next vif1) (new 'static 'vif-tag))
          (set! (-> buf base) (the pointer (&+ next 16))))
        (dma-bucket-insert-tag (-> *display* frames (-> *display* on-screen) bucket-group)
                               (bucket-id ocean-mid-far)
                               start
                               (the-as (pointer dma-tag) end)))))
  (none))

(defun ocean-3ds-packet ((this ocean))
  (let* ((buf (-> *display* frames (-> *display* on-screen) global-buf))
         (start (-> buf base)))
    (let ((packet (the-as dma-packet (-> buf base))))
      (set! (-> packet dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc 34))
      (set! (-> packet vif0) (new 'static 'vif-tag))
      (set! (-> packet vif1) (new 'static 'vif-tag :cmd (vif-cmd pc-port)))
      (set! (-> buf base) (the pointer (&+ packet 16))))
    (let ((words (the-as (pointer uint32) (-> buf base)))
          (quads (the-as (pointer uint128) (-> buf base))))
      (set! (-> words 0) #x334e434f) ;; "OCN3"
      (set! (-> words 1) (the-as uint (-> this heights)))
      (set! (-> words 2) (the-as uint (-> this ocean-colors)))
      (set! (-> words 3) (the-as uint (if (-> this mid-off) 1 0)))
      (set! (-> words 4) (the-as uint (-> this ocean-mid-indices)))
      (set! (-> words 5) (the-as uint (-> this ocean-mid-masks data)))
      (set! (-> words 6) (the-as uint (-> this ocean-trans-indices)))
      (set! (-> words 7) 0)
      (set! (-> quads 2) (-> this start-corner quad))
      (set! (-> quads 3) (-> this far-color quad))
      (set! (-> quads 4) (-> *math-camera* plane 0 quad))
      (set! (-> quads 5) (-> *math-camera* plane 1 quad))
      (set! (-> quads 6) (-> *math-camera* plane 2 quad))
      (set! (-> quads 7) (-> *math-camera* plane 3 quad))
      ;; the sky's light on the water (add-colors! as the PS2 ocean's vertices get it), toward
      ;; the camera's view: the renderer tints the water with it (w = 1.0: present)
      (let ((vtx (new 'stack-no-clear 'ocean-vertex))
            (col (-> (the (inline-array vector) quads) 8)))
        (set! (-> vtx pos quad) (-> *math-camera* inv-camera-rot vector 2 quad))
        (add-colors! this col vtx)
        (set! (-> col w) 1.0))
      ;; (AI-assisted, j2water) the sky reflection (the PS2 ocean's env map pass, as
      ;; ocean-mid-setup-constants sets it up). quad 9: env-color (128 x ocean-alpha; without the
      ;; sky the blue halved), w = 1.0: the env map ocean-3ds-envmap draws (ocean-mid-far bucket),
      ;; 0.0: the environment-ocean texture. quad 10: environment-ocean's and
      ;; environment-ocean-alphamod's tex0 (0: not loaded). quad 11: constants2 (the view's heading
      ;; and pitch as env map coordinates), z: ocean-alpha.
      (let ((ec (-> (the (inline-array vector) quads) 9))
            (f (* 128.0 (-> *time-of-day-context* ocean-alpha))))
        (set! (-> ec x) f)
        (set! (-> ec y) f)
        (set! (-> ec z) (if (-> *time-of-day-context* sky) f (* 0.5 f)))
        (set! (-> ec w) (if (-> *time-of-day-context* sky) 1.0 0.0)))
      (let ((t64 (the-as (pointer uint64) (-> (the (inline-array vector) quads) 10))))
        (set! (-> t64 0) (ocean-3ds-tex0 (get-texture environment-ocean environment-generic)))
        (set! (-> t64 1) (ocean-3ds-tex0 (get-texture environment-ocean-alphamod sky-textures))))
      (let ((fwd (-> (matrix-local->world #f #f) vector 2))
            (c2 (-> (the (inline-array vector) quads) 11)))
        (set! (-> c2 x) (- 1.5 (* 0.000015258789 (atan (-> fwd x) (-> fwd z)))))
        (set! (-> c2 y) (+ 0.5 (/ (-> fwd y) -2)))
        (set! (-> c2 z) (-> *time-of-day-context* ocean-alpha))
        (set! (-> c2 w) 0.0))
      (set! (-> quads 12) (-> *math-camera* camera-temp vector 0 quad))
      (set! (-> quads 13) (-> *math-camera* camera-temp vector 1 quad))
      (set! (-> quads 14) (-> *math-camera* camera-temp vector 2 quad))
      (set! (-> quads 15) (-> *math-camera* camera-temp vector 3 quad))
      (set! (-> quads 16) (-> *math-camera* hvdf-off quad))
      (let ((fog (-> (the (inline-array vector) quads) 17)))
        (set! (-> fog x) (-> *math-camera* pfog0))
        (set! (-> fog y) (-> *math-camera* fog-min))
        (set! (-> fog z) (-> *math-camera* fog-max))
        (set! (-> fog w) 0.0))
      (set! (-> quads 18) (-> (math-camera-pos) quad))
      (set! (-> quads 19) (-> *math-camera* camera-rot vector 0 quad))
      (set! (-> quads 20) (-> *math-camera* camera-rot vector 1 quad))
      (set! (-> quads 21) (-> *math-camera* camera-rot vector 2 quad))
      (set! (-> quads 22) (-> *math-camera* camera-rot vector 3 quad))
      (set! (-> quads 23) (-> *math-camera* perspective vector 0 quad))
      (set! (-> quads 24) (-> *math-camera* perspective vector 1 quad))
      (set! (-> quads 25) (-> *math-camera* perspective vector 2 quad))
      (set! (-> quads 26) (-> *math-camera* perspective vector 3 quad))
      ;; (AI-assisted, j2water) quads 27-33: the lights of the wave texture (ocean-generate-verts,
      ;; ocean-vu0.gc's mips2c: sewerb's light group when that level is loaded, else the time of
      ;; day's first), as vu-lights
      (let ((lights (the-as vu-lights (-> (the (inline-array vector) quads) 27)))
            (sewer (level-get *level* 'sewerb)))
        (if sewer
            (vu-lights<-light-group! lights (the-as light-group (&+ (the-as pointer sewer) 716)))
            (vu-lights<-light-group! lights (-> *time-of-day-context* light-group 0)))))
    (&+! (-> buf base) (* 16 34))
    (let ((end (-> buf base)))
      (let ((next (the-as dma-packet (-> buf base))))
        (set! (-> next dma) (new 'static 'dma-tag :id (dma-tag-id next)))
        (set! (-> next vif0) (new 'static 'vif-tag))
        (set! (-> next vif1) (new 'static 'vif-tag))
        (set! (-> buf base) (the pointer (&+ next 16))))
      (dma-bucket-insert-tag (-> *display* frames (-> *display* on-screen) bucket-group)
                             (bucket-id ocean-near)
                             start
                             (the-as (pointer dma-tag) end))))
  (none))
)

(defmethod update-map ((this ocean))
  (set! (-> this heights) #f)
  (set! (-> this verts) #f)
  (let ((s5-0 *mood-control*))
    (set! (-> this constant w) (if (and (-> s5-0 overide-weather-flag) (not (movie?)))
                                   (-> s5-0 overide cloud)
                                   (-> s5-0 current-interp cloud)
                                   )
          )
    )
  (set! (-> this constant w) (fmin 1.0 (* 2.0 (-> this constant w))))
  (let ((f0-5 1.0)
        (f30-0 1.0)
        )
    (when (= (-> *bigmap* bigmap-index) 13)
      (set! f0-5 0.333)
      (set! f30-0 0.75)
      )
    (set! (-> this frame-speed) (* (+ 4.0 (-> *setting-control* user-current rain)) f0-5))
    (set! (-> this frame-speed2) (* (+ 5.0 (-> *setting-control* user-current rain)) f0-5))
    (when (not (paused?))
      (let ((f0-8 (+ (-> this frame-num) (* (-> this frame-speed) (seconds-per-frame)))))
        (set! (-> this frame-num) (- f0-8 (* (the float (the int (/ f0-8 64.0))) 64.0)))
        )
      (let ((f0-11 (+ (-> this frame-num2) (* (-> this frame-speed2) (seconds-per-frame)))))
        (set! (-> this frame-num2) (- f0-11 (* (the float (the int (/ f0-11 64.0))) 64.0)))
        )
      )
    (let ((s5-1 (-> *display* frames (-> *display* on-screen) global-buf)))
      (set! (-> this heights) (the-as ocean-height-array (-> s5-1 base)))
      (interp-wave
        this
        (the-as ocean-wave-info (-> this heights))
        (the-as uint (-> this frame-num))
        (* 0.08325 f30-0)
        )
      (&+! (-> s5-1 base) 4096)
      (set! (-> this heights2) (the-as ocean-height-array (-> s5-1 base)))
      (interp-wave
        this
        (the-as ocean-wave-info (-> this heights2))
        (the-as uint (-> this frame-num2))
        (* 0.01665 f30-0)
        )
      (&+! (-> s5-1 base) 4096)
      (ocean-method-15 this (the-as matrix (-> this heights)) (the-as matrix (-> this heights2)))
      (set! (-> this verts) (the-as ocean-vert-array (-> s5-1 base)))
      (&+! (-> s5-1 base) #x8000)
      )
    )
  ;; og:preserve-this (AI-assisted) 3DS: the 3DS renderer draws the ocean from the map and the wave
  ;; heights (CtrOcean.cpp, as Jak 1's draw-ocean-3ds): one packet instead of the PS2's ocean DMA
  ;; (the vertices, the wave texture, the far, mid and near ocean). The heights above stay (get-height).
  (#when TARGET_3DS
    (when (and (not (or (-> this off) (-> *blit-displays-work* menu-mode)))
               (logtest? (-> *display* vu1-enable-user) (vu1-renderer-mask ocean)))
      (mem-copy! (the-as pointer (-> this haze-lights)) (the-as pointer (-> *sky-work* haze-lights)) 124)
      ;; (AI-assisted, j2water) the sky reflection's env map, as the PS2 draws it
      (if (-> *time-of-day-context* sky)
          (ocean-3ds-envmap this))
      (ocean-3ds-packet this)))
  (when (and (#if TARGET_3DS #f #t) (not (or (-> this off) (-> *blit-displays-work* menu-mode))))
    (when (logtest? (-> *display* vu1-enable-user) (vu1-renderer-mask ocean))
      (mem-copy! (the-as pointer (-> this cloud-lights)) (the-as pointer (-> *sky-work* cloud-lights)) 156)
      (mem-copy! (the-as pointer (-> this haze-lights)) (the-as pointer (-> *sky-work* haze-lights)) 124)
      (vector4-scale!
        (the-as vector4 (-> this sky-color))
        (the-as vector4 (-> *time-of-day-context* current-sky-color))
        0.0078125
        )
      (generate-verts this (-> this verts) (-> this heights))
      (let* ((s4-0 (-> *display* frames (-> *display* on-screen) global-buf))
             (s5-2 (-> s4-0 base))
             )
        (if (-> *time-of-day-context* sky)
            (ocean-method-89 this s4-0)
            )
        (draw-ocean-texture this s4-0 (the-as int (-> this verts)))
          ;; disable whatever this is
          ;; (ocean-method-79 this s4-0)
        (init-buffer! this s4-0)
        (if (-> this far-on)
            (draw-ocean-far this s4-0)
            )
        (if (not (-> this mid-off))
            (draw-ocean-mid this s4-0)
            )
        (end-buffer! this s4-0)
        (set-dirty-mask! (-> *level* default-level) 9 #xc0000 #x2a000)
        (let ((a3-3 (-> s4-0 base)))
          (let ((v1-87 (the-as object (-> s4-0 base))))
            (set! (-> (the-as dma-packet v1-87) dma) (new 'static 'dma-tag :id (dma-tag-id next)))
            (set! (-> (the-as dma-packet v1-87) vif0) (new 'static 'vif-tag))
            (set! (-> (the-as dma-packet v1-87) vif1) (new 'static 'vif-tag))
            (set! (-> s4-0 base) (&+ (the-as pointer v1-87) 16))
            )
          (dma-bucket-insert-tag
            (-> *display* frames (-> *display* on-screen) bucket-group)
            (bucket-id ocean-mid-far)
            s5-2
            (the-as (pointer dma-tag) a3-3)
            )
          )
        )
      (when (not (or (-> this near-off)
                     (or (-> this mid-off) (< 196608.0 (fabs (- (-> this start-corner y) (-> *math-camera* trans y)))))
                     )
                 )
        (let* ((s4-1 (-> *display* frames (-> *display* on-screen) global-buf))
               (s5-3 (-> s4-1 base))
               )
          (draw-ocean-texture this s4-1 (the-as int (-> this verts)))
          (draw-ocean-near this s4-1)
          (end-buffer! this s4-1)
          (set-dirty-mask! (-> *level* default-level) 7 #xc0000 #x2a000)
          (let ((a3-5 (-> s4-1 base)))
            (let ((v1-113 (the-as object (-> s4-1 base))))
              (set! (-> (the-as dma-packet v1-113) dma) (new 'static 'dma-tag :id (dma-tag-id next)))
              (set! (-> (the-as dma-packet v1-113) vif0) (new 'static 'vif-tag))
              (set! (-> (the-as dma-packet v1-113) vif1) (new 'static 'vif-tag))
              (set! (-> s4-1 base) (&+ (the-as pointer v1-113) 16))
              )
            (dma-bucket-insert-tag
              (-> *display* frames (-> *display* on-screen) bucket-group)
              (bucket-id ocean-near)
              s5-3
              (the-as (pointer dma-tag) a3-5)
              )
            )
          )
        )
      )
    )
  (when (not (paused?))
    (set! (-> this off) #f)
    (set! (-> this mid-off) #f)
    (set! (-> this near-off) (if this
                                 (not (-> this ocean-near-translucent?))
                                 #f
                                 )
          )
    )
  0
  (none)
  )

;; og:preserve-this PC Port hack
(define *ocean-generate-verts-vector* (new 'global 'vector))

(set-vector! *ocean-generate-verts-vector*
             (the-as float #x43000000) ;; in jak1, this component was different!
             (the-as float #x43000000)
             (the-as float #x43000000)
             (the-as float #x43000000)
             )

(defmethod draw! ((this ocean))
  (do-tex-scroll! this)
  (set! *ocean-map* #f)
  (set! (-> this far-on) #f)
  (dotimes (v1-2 (-> *level* length))
    (let ((a0-5 (-> *level* level v1-2)))
      (when (= (-> a0-5 status) 'active)
        (if (-> a0-5 info ocean-far?)
            (set! (-> this far-on) #t)
            )
        (let ((a1-7 (-> a0-5 info ocean)))
          (cond
            ((= a1-7 'none)
             (when (-> a0-5 meta-inside?)
               (set! *ocean-map* #f)
               (goto cfg-17)
               )
             )
            ((and a1-7 (nonzero? (-> a1-7 value)))
             (set! *ocean-map* (the-as ocean-map (-> a1-7 value)))
             (set! (-> this ocean-near-translucent?) (-> a0-5 info ocean-near-translucent?))
             )
            )
          )
        )
      )
    )
  (label cfg-17)
  (if *ocean-map*
      (mem-copy! (the-as pointer this) (the-as pointer *ocean-map*) 56)
      )
  (let ((v1-9 (new 'stack-no-clear 'vector)))
    (if (-> *time-of-day-context* use-camera-other)
        (set! (-> v1-9 quad) (-> *math-camera* inv-camera-rot-other vector 2 quad))
        (set! (-> v1-9 quad) (-> *math-camera* inv-camera-rot vector 2 quad))
        )
    (cond
      ((< (fabs (-> v1-9 z)) (fabs (-> v1-9 x)))
       (if (< (-> v1-9 x) 0.0)
           (set! (-> this ocean-facing) (the-as uint 3))
           (set! (-> this ocean-facing) (the-as uint 2))
           )
       )
      ((< (-> v1-9 z) 0.0)
       (set! (-> this ocean-facing) (the-as uint 0))
       0
       )
      (else
        (set! (-> this ocean-facing) (the-as uint 1))
        )
      )
    )
  0
  (none)
  )
